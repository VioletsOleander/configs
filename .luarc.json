{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "completion": {
    "autoRequire": false
  },
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true,
    "path": ["?.lua", "?/init.lua", "lua/?.lua", "lua/?/init.lua"]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "${workspaceFolder}/.lua_modules/vim",
      "${workspaceFolder}/.lua_modules/uv",
      "${workspaceFolder}/.lua_modules/lazy/snacks.nvim/lua/snacks/init.lua",
      "${workspaceFolder}/.lua_modules/lazy/snacks.nvim/lua/snacks/meta",
      "${workspaceFolder}/.lua_modules/lazy/snacks.nvim/lua/snacks/picker/config",
      "${workspaceFolder}/.lua_modules/lazy/snacks.nvim/lua/snacks/picker/types.lua",
      "${workspaceFolder}/.lua_modules/lazy/snacks.nvim/lua/snacks/notifier.lua",
      "${workspaceFolder}/.lua_modules/lazy/lazy.nvim/lua/lazy/types.lua",
      "${workspaceFolder}/.lua_modules/lazy/blink.cmp/lua/blink/cmp/config",
      "${workspaceFolder}/.lua_modules/lazy/blink.cmp/lua/blink/cmp/types.lua",
      "${workspaceFolder}/.lua_modules/lazy/conform.nvim/lua/conform/types.lua",
      "${workspaceFolder}/.lua_modules/lazy/oil.nvim/lua/oil/config.lua",
      "${workspaceFolder}/.lua_modules/lazy/flash.nvim/lua/flash/config.lua"
    ],
    "ignoreDir": [
      ".vscode",
      ".git",
      ".github",
      ".cargo",
      "doc",
      "docs",
      "test",
      "tests",
      "examples",
      "extras",
      "scripts",
      "target",
      "after",
      "colors",
      "autoload",
      "queries"
    ]
  }
}
